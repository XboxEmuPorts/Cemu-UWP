<Page
    x:Class="Cemu_UWP_Host.DirectXPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cemu_UWP_Host"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    Background="#FFFBFCF9">

  <Page.Resources>
    <!-- Arcade Botanico: porcelain surfaces, Circuit Green focus and sage secondary planes. -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFBFCF9" />
    <SolidColorBrush x:Key="TopBarBrush" Color="#FFFFFEFC" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FDFBFCF9" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF16352B" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF0C8B57" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#FF087247" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF657D72" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FFD2E5D8" />
    <SolidColorBrush x:Key="SageBrush" Color="#FFD7F2E4" />

    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="HelpfulTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LibraryItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Width" Value="218" />
      <Setter Property="Height" Value="218" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="7" />
    </Style>

    <Style TargetType="PivotItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="GraphicPackItemStyle" TargetType="GridViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="AppBarButton">
      <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
    </Style>

    <Style TargetType="Pivot">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <DataTemplate x:Key="HiddenPivotHeaderTemplate">
      <Grid Width="0" Height="0" />
    </DataTemplate>

    <Style x:Key="SidebarButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="50" />
      <Setter Property="Width" Value="182" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
  </Page.Resources>

  <Grid Background="{StaticResource PageBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="218" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="navigationRail"
            Grid.Column="0"
            Background="#D6FFFFFC"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <Grid Padding="18,26,18,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="4,0,0,32">
          <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource SageBrush}">
            <Image Source="Assets/Square44x44Logo.png" Width="36" Height="36"
                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="11,3,0,0">
            <TextBlock Text="CEMU UWP" FontFamily="Consolas" FontSize="10"
                       Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="Botanical Arcade" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="homeNavigationButton" Style="{StaticResource SidebarButtonStyle}" Tag="0" Click="NavigationButton_Click" Background="{StaticResource AccentBlueBrush}" Foreground="White">
            <StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE80F;" Width="28"/><TextBlock Text="Home" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="libraryNavigationButton" Style="{StaticResource SidebarButtonStyle}" Tag="1" Click="NavigationButton_Click">
            <StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE8B7;" Width="28"/><TextBlock Text="Library" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="toyPadNavigationButton" Style="{StaticResource SidebarButtonStyle}" Tag="2" Click="NavigationButton_Click">
            <StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE7FC;" Width="28"/><TextBlock Text="Toy Pad" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="graphicPacksNavigationButton" Style="{StaticResource SidebarButtonStyle}" Tag="3" Click="NavigationButton_Click">
            <StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE9D2;" Width="28"/><TextBlock Text="Graphic packs" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="settingsNavigationButton" Style="{StaticResource SidebarButtonStyle}" Tag="4" Click="NavigationButton_Click">
            <StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE713;" Width="28"/><TextBlock Text="Settings" Margin="10,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="helpNavigationButton" Style="{StaticResource SidebarButtonStyle}" Tag="5" Click="NavigationButton_Click">
            <StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE897;" Width="28"/><TextBlock Text="Help and errors" Margin="10,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="5,15,5,0">
          <StackPanel>
            <TextBlock Text="● SYSTEM CONNECTED" FontFamily="Consolas" FontSize="10"
                       Foreground="{StaticResource AccentBlueBrush}" />
            <TextBlock Text="DirectX 11 · FL 11.0" Margin="0,6,0,0" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="stageGrid" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

    <!-- The emulator always fills the available stage. Before a
         game starts, the tools cover this entire area; while a game runs they
         collapse without resizing the SwapChainPanel. -->
    <Grid x:Name="emulatorViewport"
          Grid.Row="0"
          Grid.RowSpan="2"
          Background="#FFEAF5ED"
          PointerPressed="EmulatorViewport_PointerPressed"
          SizeChanged="EmulatorViewport_SizeChanged">
      <SwapChainPanel x:Name="emulatorSurface"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      CompositionScaleChanged="EmulatorSurface_CompositionScaleChanged" />

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
        <TextBlock x:Name="emulatorPlaceholder"
                   Text="The game will appear here"
                   FontSize="16"
                   Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>

      <!-- Shown only while a brokered external title is being staged. Keeping
           it above the SwapChainPanel prevents the blank presentation surface
           from looking like a frozen or failed launch. -->
      <Grid x:Name="externalLoadingOverlay"
            Canvas.ZIndex="25"
            Background="#F2FBFCF9"
            Visibility="Collapsed"
            IsHitTestVisible="True">
        <Border Width="430"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource AccentBlueBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="32,28">
          <StackPanel HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Center"
                  Width="72"
                  Height="72"
                  Margin="0,0,0,18">
              <ProgressRing x:Name="externalLoadingRing"
                            Width="72"
                            Height="72"
                            IsActive="False"
                            Foreground="{StaticResource AccentBlueBrush}" />
              <FontIcon Glyph="&#xE768;"
                        FontSize="25"
                        Foreground="{StaticResource AccentBlueBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="externalLoadingTitle"
                       Text="Loading external game"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextAlignment="Center" />
            <TextBlock x:Name="externalLoadingDetail"
                       Text="Preparing external storage..."
                       FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,8,0,16" />
            <ProgressBar x:Name="externalLoadingProgress"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Height="10"
                         Foreground="{StaticResource AccentBlueBrush}"
                         Background="{StaticResource SageBrush}" />
            <TextBlock x:Name="externalLoadingPercent"
                       Text="0%"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextAlignment="Center"
                       Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Optional in-game Wii U GamePad pointer. This is not used for XAML
           navigation; L+R toggles it only after a title has started. -->
      <!-- Keep the pointer hotspot at the upper-left corner. A Path is used
           instead of the combined touch-pointer glyph so only the arrow is
           shown over the game. -->
      <Path x:Name="virtualMouseCursor"
            Canvas.ZIndex="30"
            Width="22"
            Height="30"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Data="M 1,1 L 1,25 L 7.5,18.5 L 12.5,29 L 17,27 L 12,17 L 21,17 Z"
            Fill="White"
            Stroke="#FF07130F"
            StrokeThickness="1.5"
            Stretch="Fill"
            Visibility="Collapsed">
        <Path.RenderTransform>
          <TranslateTransform x:Name="virtualMouseTransform" />
        </Path.RenderTransform>
      </Path>

      <Grid x:Name="tabsPanel"
            Canvas.ZIndex="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource PanelBrush}">
        <Pivot x:Name="toolTabs"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
                Background="Transparent"
                Foreground="{StaticResource TextBrush}"
                HeaderTemplate="{StaticResource HiddenPivotHeaderTemplate}"
                SelectionChanged="ToolTabs_SelectionChanged">
          <PivotItem Header="Home">
            <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Padding="24,14,24,22" Spacing="18">
                <Grid Height="250">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="4,0,28,0">
                    <TextBlock Text="✦  EMULATION" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBlueBrush}" />
                    <TextBlock Text="Emulator&#x0a;ready." FontSize="42" FontWeight="SemiBold" LineHeight="40" Margin="0,15,0,14" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Manage content and access your games through a clear, controller-friendly interface." Style="{StaticResource HelpfulTextStyle}" MaxWidth="310" HorizontalAlignment="Left" />
                  </StackPanel>
                  <Border Grid.Column="1" CornerRadius="30,14,30,14" Padding="24">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF0A6746" Offset="0"/><GradientStop Color="#FF0C8B57" Offset="0.48"/><GradientStop Color="#FFA5DEC0" Offset="0.49"/><GradientStop Color="#FFEAF7EF" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Grid>
                      <Border HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="15" BorderBrush="#77FFFFFF" BorderThickness="1" Background="#22FFFFFF" Padding="10,6"><TextBlock Text="●  SESSION AVAILABLE" FontFamily="Consolas" FontSize="10" Foreground="White"/></Border>
                      <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="LIBRARY · CEMU UWP" FontFamily="Consolas" FontSize="10" Foreground="#FFD6FFE2"/>
                        <TextBlock Text="Select a title&#x0a;to get started." FontSize="34" FontWeight="SemiBold" LineHeight="32" Foreground="White" Margin="0,8,0,13"/>
                        <StackPanel Orientation="Horizontal">
                          <Button Tag="1" Click="NavigationButton_Click" Background="White" Foreground="#FF086443" BorderThickness="0" CornerRadius="13" Padding="15,9"><TextBlock Text="▶  Open library" FontWeight="SemiBold"/></Button>
                          <TextBlock Text="DirectX 11 · FL 11.0" FontFamily="Consolas" FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>

                <TextBlock Text="Management" Style="{StaticResource SectionHeadingStyle}"/>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8"><TextBlock Text="Content" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Install games, updates, and keys." Style="{StaticResource HelpfulTextStyle}"/>
                      <Button x:Name="installContentButton" Content="＋  Install content" HorizontalAlignment="Stretch" IsEnabled="False" Click="InstallContent_Click"/>
                      <Button x:Name="importKeysButton" Content="▤  Import keys.txt" HorizontalAlignment="Stretch" IsEnabled="False" Click="ImportKeys_Click"/>
                      <Button x:Name="refreshLibraryButton" Content="↻  Scan local folder" HorizontalAlignment="Stretch" IsEnabled="False" Click="RefreshLibrary_Click"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8"><TextBlock Text="External storage" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Manage folders without copying games." Style="{StaticResource HelpfulTextStyle}"/>
                      <Button x:Name="scanExternalStorageButton" Content="＋  Add external folder" HorizontalAlignment="Stretch" IsEnabled="False" Click="ScanExternalStorage_Click"/>
                      <Button x:Name="rescanExternalStorageButton" Content="↻  Rescan external folders" HorizontalAlignment="Stretch" IsEnabled="False" Click="RescanExternalStorage_Click"/>
                      <Button x:Name="forgetExternalStorageButton" Content="×  Forget external folders" HorizontalAlignment="Stretch" IsEnabled="False" Click="ForgetExternalStorage_Click"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8"><TextBlock Text="Resources and maintenance" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Update packs and manage the cache." Style="{StaticResource HelpfulTextStyle}"/>
                      <Button x:Name="downloadGraphicPacksButton" Content="↓  Download graphic packs" HorizontalAlignment="Stretch" IsEnabled="False" Click="DownloadGraphicPacks_Click"/>
                      <Button x:Name="installGraphicPacksButton" Content="＋  Install graphic packs" HorizontalAlignment="Stretch" IsEnabled="False" Click="InstallGraphicPacks_Click"/>
                      <Button x:Name="clearShaderCacheButton" Content="⌫  Clear shader cache" HorizontalAlignment="Stretch" IsEnabled="False" Click="ClearShaderCache_Click"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </PivotItem>

          <PivotItem Header="Library">
            <Grid Padding="24,14,24,22">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border CornerRadius="16" Background="#FF10382B" Padding="16" Margin="0,0,0,14">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="SYSTEM" FontFamily="Consolas" FontSize="10" Foreground="#FFA5DEC0"/><TextBlock x:Name="selectedGameStatus" Text="Select a game" FontSize="20" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="shaderCacheStatus" Text="Shader cache     0 shaders" FontFamily="Consolas" FontSize="10" Foreground="#FFB9D8CA"/>
                    <TextBlock Text="Controller       GamePad" FontFamily="Consolas" FontSize="10" Foreground="#FFB9D8CA" Margin="0,4,0,0"/>
                    <TextBlock x:Name="rendererMetricsText" Text="Renderer         D3D11" FontFamily="Consolas" FontSize="10" Foreground="#FFB9D8CA" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button x:Name="startButton" Grid.Column="2" Content="Start game" Click="StartGame_Click" IsEnabled="False" Visibility="Collapsed" Padding="22,10" VerticalAlignment="Center" Background="White" Foreground="#FF086443" BorderThickness="0" CornerRadius="10"/>
                </Grid>
              </Border>
              <Border Grid.Row="1" Background="#FFF7FBF8" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="5">
                <ListView x:Name="installedGamesList"
                          Background="Transparent"
                          Foreground="{StaticResource TextBrush}"
                          ItemContainerStyle="{StaticResource LibraryItemStyle}"
                          SelectionChanged="InstalledGames_SelectionChanged"
                          ItemClick="InstalledGames_ItemClick"
                          IsItemClickEnabled="True"
                           SelectionMode="Single"
                           SingleSelectionFollowsFocus="False">
                  <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                      <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListView.ItemsPanel>
                  <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF0C8B57" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF087247" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#55D7F2E4" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="White" />
                  </ListView.Resources>
                </ListView>
              </Border>
            </Grid>
          </PivotItem>

          <PivotItem Header="Toy Pad">
            <Grid Padding="24,6,24,22">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel>
                <TextBlock Text="LEGO Dimensions Toy Pad"
                           Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="Choose a character, vehicle, or gadget and place its persistent virtual tag on the native Toy Pad. Game-written upgrades are saved automatically. Press View + Menu during a game to open or close options."
                           Style="{StaticResource HelpfulTextStyle}"
                           Margin="0,3,0,10" />
              </StackPanel>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="dimensionsFigureBox"
                          Header="Figure"
                          PlaceholderText="Choose a figure"
                          IsEnabled="False"
                          Margin="0,0,12,0"
                          HorizontalAlignment="Stretch" />
                <ComboBox x:Name="dimensionsSlotBox"
                          Grid.Column="1"
                          Header="Toy Pad position"
                          SelectedIndex="1"
                          IsEnabled="False"
                          Margin="0,0,12,0"
                          HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="Left: top" />
                  <ComboBoxItem Content="Center" />
                  <ComboBoxItem Content="Right: top" />
                  <ComboBoxItem Content="Left: lower 1" />
                  <ComboBoxItem Content="Left: lower 2" />
                  <ComboBoxItem Content="Right: lower 1" />
                  <ComboBoxItem Content="Right: lower 2" />
                </ComboBox>
                <Button x:Name="placeDimensionsFigureButton"
                        Grid.Column="2"
                        Content="Place or replace"
                        IsEnabled="False"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,0"
                        Click="PlaceDimensionsFigure_Click" />
                <Button x:Name="removeDimensionsFigureButton"
                        Grid.Column="3"
                        Content="Remove"
                        IsEnabled="False"
                        VerticalAlignment="Bottom"
                        Click="RemoveDimensionsFigure_Click" />
              </Grid>

              <StackPanel Grid.Row="2"
                          Orientation="Horizontal"
                          Margin="0,10,0,0">
                <ComboBox x:Name="dimensionsSourceSlotBox"
                          Header="Move existing tag from"
                          SelectedIndex="1"
                          IsEnabled="False"
                          Width="250"
                          Margin="0,0,8,0">
                  <ComboBoxItem Content="Left: top" />
                  <ComboBoxItem Content="Center" />
                  <ComboBoxItem Content="Right: top" />
                  <ComboBoxItem Content="Left: lower 1" />
                  <ComboBoxItem Content="Left: lower 2" />
                  <ComboBoxItem Content="Right: lower 1" />
                  <ComboBoxItem Content="Right: lower 2" />
                </ComboBox>
                <Button x:Name="moveDimensionsFigureButton"
                        Content="Move to selected position"
                        IsEnabled="False"
                        VerticalAlignment="Bottom"
                        Click="MoveDimensionsFigure_Click" />
              </StackPanel>

              <Border Grid.Row="3"
                      Background="{StaticResource CardBrush}"
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12,9"
                      Margin="0,12,0,0">
                <TextBlock x:Name="dimensionsStatus"
                           Text="The native Toy Pad will be ready when Cemu finishes initializing."
                           Style="{StaticResource HelpfulTextStyle}" />
              </Border>
            </Grid>
          </PivotItem>

          <PivotItem Header="Graphic packs">
            <Grid Padding="24,6,24,18">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Graphic packs by game" Style="{StaticResource SectionHeadingStyle}" />
                  <TextBlock Text="Choose a game, then enable only the installed packs you want to use on its next launch."
                             Style="{StaticResource HelpfulTextStyle}" Margin="0,2,12,0" />
                </StackPanel>
                <Button x:Name="installGraphicPacksTabButton" Grid.Column="1"
                        Content="Install packs" IsEnabled="False"
                        Click="InstallGraphicPacks_Click" />
                <Button x:Name="downloadGraphicPacksTabButton" Grid.Column="2"
                        Content="Download community packs" IsEnabled="False"
                        Click="DownloadGraphicPacks_Click" />
              </Grid>
              <ComboBox x:Name="graphicPackGameBox" Grid.Row="1"
                        Header="Game" PlaceholderText="Choose a game"
                        HorizontalAlignment="Stretch" Margin="0,10,0,10"
                        IsEnabled="False"
                        SelectionChanged="GraphicPackGame_SelectionChanged" />
              <Border Grid.Row="2" Background="#FFF7FBF8"
                      BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                      CornerRadius="5" Padding="5">
                <GridView x:Name="graphicPacksList" Background="Transparent"
                          Foreground="{StaticResource TextBrush}" SelectionMode="None"
                          IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource GraphicPackItemStyle}"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SizeChanged="GraphicPacksList_SizeChanged">
                  <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                      <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </GridView.ItemsPanel>
                  <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:GraphicPackViewModel">
                      <Border Background="{StaticResource CardBrush}"
                              BorderBrush="{StaticResource DividerBrush}"
                              BorderThickness="1" CornerRadius="4"
                              Padding="12,10">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                     FontSize="15" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                     MaxLines="2" />
                          <TextBlock Grid.Row="1" Text="{x:Bind Category, Mode=OneWay}"
                                     FontSize="12" Margin="0,3,0,0"
                                     Foreground="{StaticResource AccentBlueBrush}"
                                     TextWrapping="Wrap" MaxLines="1"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Row="2" Text="{x:Bind Description, Mode=OneWay}"
                                     FontSize="12" Margin="0,5,0,4"
                                     Foreground="{StaticResource MutedTextBrush}"
                                     TextWrapping="Wrap" MaxLines="3"
                                     TextTrimming="CharacterEllipsis" />
                          <ToggleSwitch Grid.Row="3" Header="Enabled" OnContent="Enabled" OffContent="Disabled"
                                        HorizontalAlignment="Left"
                                        IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                        Tag="{x:Bind Identity, Mode=OneWay}"
                                        Toggled="GraphicPack_Toggled" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </GridView.ItemTemplate>
                </GridView>
              </Border>
              <TextBlock x:Name="graphicPacksStatus" Grid.Row="3"
                         Text="Graphic packs become available when Cemu is ready."
                         Style="{StaticResource HelpfulTextStyle}" Margin="0,8,0,0" />
            </Grid>
          </PivotItem>

          <PivotItem Header="Settings">
            <Grid Padding="24,6,24,16">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <StackPanel>
                  <TextBlock Text="Cemu settings" Style="{StaticResource SectionHeadingStyle}" />
                  <TextBlock Text="Direct3D 11 is the fixed graphics backend for the UWP host."
                             Style="{StaticResource HelpfulTextStyle}" Margin="0,2,16,8" />
                </StackPanel>
              </Grid>
              <ScrollViewer Grid.Row="1"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Visible"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Disabled"
                            IsTabStop="True">
                <StackPanel Spacing="10">
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <Grid ColumnSpacing="16">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionHeadingStyle}" />
                        <ComboBox x:Name="cpuModeBox" Header="CPU mode" SelectedIndex="4" SelectionChanged="SettingsSelectionChanged">
                          <ComboBoxItem Content="Single-core interpreter"/><ComboBoxItem Content="Single-core recompiler"/>
                          <ComboBoxItem Content="Dual-core recompiler (legacy)"/><ComboBoxItem Content="Multi-core recompiler"/><ComboBoxItem Content="Auto"/>
                        </ComboBox>
                        <ComboBox x:Name="consoleLanguageBox" Header="Console language" SelectedIndex="1" SelectionChanged="SettingsSelectionChanged">
                          <ComboBoxItem Content="Japanese"/><ComboBoxItem Content="English"/><ComboBoxItem Content="French"/><ComboBoxItem Content="German"/>
                          <ComboBoxItem Content="Italian"/><ComboBoxItem Content="Spanish"/><ComboBoxItem Content="Chinese"/><ComboBoxItem Content="Korean"/>
                          <ComboBoxItem Content="Dutch"/><ComboBoxItem Content="Portuguese"/><ComboBoxItem Content="Russian"/><ComboBoxItem Content="Taiwanese"/>
                        </ComboBox>
						<ComboBox x:Name="emulatedControllerBox" Header="Player 1 Wii U controller" SelectedIndex="0" SelectionChanged="SettingsSelectionChanged">
						  <ComboBoxItem Content="Wii U GamePad"/>
						  <ComboBoxItem Content="Wii U Pro Controller"/>
						  <ComboBoxItem Content="Wii Classic Controller"/>
						  <ComboBoxItem Content="Wii Remote"/>
						</ComboBox>
                        <CheckBox x:Name="bootSoundCheck" Content="Play boot sound" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                        <CheckBox x:Name="disableScreensaverCheck" Content="Disable screen saver" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Graphics" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="Graphics API: Direct3D 11" Style="{StaticResource HelpfulTextStyle}"/>
                        <ComboBox x:Name="vsyncBox" Header="VSync" SelectedIndex="1" SelectionChanged="SettingsSelectionChanged"><ComboBoxItem Content="Off"/><ComboBoxItem Content="On"/></ComboBox>
                        <CheckBox x:Name="asyncCompileCheck" Content="Async shader compile" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                        <CheckBox x:Name="gx2SyncCheck" Content="GX2DrawDone synchronization" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                        <CheckBox x:Name="upsideDownCheck" Content="Render upside down" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                        <CheckBox x:Name="performanceMetricsCheck" Content="Show performance metrics" Checked="PerformanceMetricsCheckChanged" Unchecked="PerformanceMetricsCheckChanged"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Scaling and gamma" Style="{StaticResource SectionHeadingStyle}" />
                        <ComboBox x:Name="upscaleFilterBox" Header="Upscale filter" SelectedIndex="1" SelectionChanged="SettingsSelectionChanged"><ComboBoxItem Content="Linear"/><ComboBoxItem Content="Bicubic"/><ComboBoxItem Content="Bicubic Hermite"/><ComboBoxItem Content="Nearest neighbor"/></ComboBox>
                        <ComboBox x:Name="downscaleFilterBox" Header="Downscale filter" SelectedIndex="0" SelectionChanged="SettingsSelectionChanged"><ComboBoxItem Content="Linear"/><ComboBoxItem Content="Bicubic"/><ComboBoxItem Content="Bicubic Hermite"/><ComboBoxItem Content="Nearest neighbor"/></ComboBox>
                        <ComboBox x:Name="scalingBox" Header="Fullscreen scaling" SelectedIndex="0" SelectionChanged="SettingsSelectionChanged"><ComboBoxItem Content="Keep aspect ratio"/><ComboBoxItem Content="Stretch"/></ComboBox>
                        <CheckBox x:Name="overrideGammaCheck" Content="Override game gamma" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                        <Slider x:Name="gammaSlider" Header="Gamma" Minimum="1" Maximum="3" StepFrequency="0.1" Value="2.2" ValueChanged="SettingsValueChanged"/>
                        <Slider x:Name="displayGammaSlider" Header="Display gamma (0 = sRGB)" Minimum="0" Maximum="3" StepFrequency="0.1" Value="2.2" ValueChanged="SettingsValueChanged"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <Grid ColumnSpacing="16">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Notifications" Style="{StaticResource SectionHeadingStyle}" />
                        <ComboBox x:Name="notificationPositionBox" Header="Position" SelectedIndex="1" SelectionChanged="SettingsSelectionChanged"><ComboBoxItem Content="Disabled"/><ComboBoxItem Content="Top left"/><ComboBoxItem Content="Top center"/><ComboBoxItem Content="Top right"/><ComboBoxItem Content="Bottom left"/><ComboBoxItem Content="Bottom center"/><ComboBoxItem Content="Bottom right"/></ComboBox>
                        <Slider x:Name="notificationScaleSlider" Header="Text scale" Minimum="50" Maximum="300" StepFrequency="10" Value="100" ValueChanged="SettingsValueChanged"/>
                        <CheckBox x:Name="notifyProfilesCheck" Content="Controller profiles" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/><CheckBox x:Name="notifyBatteryCheck" Content="Controller battery" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                        <CheckBox x:Name="notifyShadersCheck" Content="Shader compiling" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/><CheckBox x:Name="notifyFriendsCheck" Content="Friends" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Audio" Style="{StaticResource SectionHeadingStyle}" />
                        <ComboBox x:Name="audioApiBox" Header="Audio backend" SelectedIndex="0" SelectionChanged="SettingsSelectionChanged"><ComboBoxItem Content="XAudio 2.8 (recommended)"/><ComboBoxItem Content="DirectSound"/><ComboBoxItem Content="XAudio 2.7"/><ComboBoxItem Content="Cubeb"/></ComboBox>
                        <Slider x:Name="audioDelaySlider" Header="Latency level" Minimum="0" Maximum="10" StepFrequency="1" Value="2" ValueChanged="SettingsValueChanged"/>
                        <ComboBox x:Name="tvChannelsBox" Header="TV channels" SelectedIndex="1" SelectionChanged="SettingsSelectionChanged"><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Stereo"/><ComboBoxItem Content="Surround"/></ComboBox>
                        <ComboBox x:Name="padChannelsBox" Header="GamePad channels" SelectedIndex="1" SelectionChanged="SettingsSelectionChanged"><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Stereo"/><ComboBoxItem Content="Surround"/></ComboBox>
                        <ComboBox x:Name="inputChannelsBox" Header="Input channels" SelectedIndex="0" SelectionChanged="SettingsSelectionChanged"><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Stereo"/><ComboBoxItem Content="Surround"/></ComboBox>
                        <Slider x:Name="tvVolumeSlider" Header="TV volume" Minimum="0" Maximum="100" StepFrequency="1" Value="50" ValueChanged="SettingsValueChanged"/>
                        <Slider x:Name="padVolumeSlider" Header="GamePad volume" Minimum="0" Maximum="100" StepFrequency="1" Value="0" ValueChanged="SettingsValueChanged"/>
                        <Slider x:Name="inputVolumeSlider" Header="Input volume" Minimum="0" Maximum="100" StepFrequency="1" Value="50" ValueChanged="SettingsValueChanged"/>
                        <Slider x:Name="portalVolumeSlider" Header="Portal volume" Minimum="0" Maximum="100" StepFrequency="1" Value="50" ValueChanged="SettingsValueChanged"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <StackPanel>
                      <TextBlock Text="Emulated USB devices" Style="{StaticResource SectionHeadingStyle}" />
                      <StackPanel Orientation="Horizontal" Spacing="20">
                        <CheckBox x:Name="skylandersCheck" Content="Skylanders portal" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                        <CheckBox x:Name="infinityCheck" Content="Disney Infinity base" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                        <CheckBox x:Name="dimensionsCheck" Content="LEGO Dimensions Toy Pad" Checked="SettingsCheckChanged" Unchecked="SettingsCheckChanged"/>
                      </StackPanel>
                      <TextBlock Text="USB-device changes require restarting the app before launching a game." Style="{StaticResource HelpfulTextStyle}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock x:Name="settingsStatus" Text="Settings become available when Cemu is ready." Style="{StaticResource HelpfulTextStyle}" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </PivotItem>

          <PivotItem Header="Help and errors">
            <Grid Padding="24,6,24,22">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Session diagnostics"
                             Style="{StaticResource SectionHeadingStyle}" />
                  <TextBlock Text="If something does not work, check the latest message below. The complete log is stored in the app's local data."
                             Style="{StaticResource HelpfulTextStyle}"
                             Margin="0,3,16,0" />
                </StackPanel>
                <AppBarButton Grid.Column="1"
                              Label="Clear messages"
                              Icon="Delete"
                              Foreground="{StaticResource AccentBlueBrush}"
                              Click="ClearErrors_Click"
                              HorizontalAlignment="Right" />
              </Grid>

              <Border Grid.Row="1"
                      Background="#FFF7FBF8"
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="8">
                <ListView x:Name="errorsList"
                          Background="Transparent"
                          Margin="0">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="4,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="4" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#FFE57373"
                                CornerRadius="2"
                                Margin="0,1,10,1" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   Foreground="#FF7A1F1F" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>
            </Grid>
          </PivotItem>
        </Pivot>
      </Grid>
    </Grid>
      <Border x:Name="commandFooter" Grid.Row="1" Canvas.ZIndex="20"
              VerticalAlignment="Bottom" Background="#EDFFFFFC"
              BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
              Padding="22,10" IsHitTestVisible="False">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="A" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" />
            <TextBlock Text="  Confirm     B  Back     ↕  Navigate     MENU  Options" Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,14,0">
            <Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource AccentBlueBrush}" Margin="0,0,8,0"/>
            <TextBlock x:Name="launchStatus" Text="Initializing emulator..." FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                      ToolTipService.ToolTip="{Binding Text, ElementName=controllerStatus}">
            <FontIcon x:Name="controllerStatusIcon" Glyph="&#xE7FC;" FontSize="15"
                      Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,6,0"/>
            <TextBlock x:Name="controllerStatus" Text="Disconnected" MaxWidth="125"
                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                      ToolTipService.ToolTip="{Binding Text, ElementName=accountStatus}">
            <FontIcon x:Name="accountStatusIcon" Glyph="&#xE77B;" FontSize="15"
                      Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,6,0"/>
            <TextBlock x:Name="accountStatus" Text="Account unavailable" MaxWidth="145"
                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Width="25" Height="3" CornerRadius="2" Background="{StaticResource AccentBlueBrush}" Margin="0,0,9,0" />
            <TextBlock x:Name="currentTabStatus" Text="Home" Foreground="{StaticResource AccentBlueBrush}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
